{
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "types": [
            "node",
            "@docusaurus/module-type-aliases",
            "@docusaurus/theme-classic"
        ]
    },
    "include": [
        "*.ts",
        "src/**/*.ts",
        "src/**/*.tsx"
    ]
}
